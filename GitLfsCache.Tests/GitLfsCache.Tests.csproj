<Project Sdk="MSTest.Sdk">
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>

    <!-- CA1707: underscores in test method names. CA1515: test classes must be public for MSTest
         discovery. CS1591: no XML documentation required in test code. CA2007: the test host has no
         synchronization context, so ConfigureAwait cannot change behavior here and only adds noise
         to every await in a test. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CS1591;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testably.Abstractions.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitLfsCache\GitLfsCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
