<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <!-- An ASP.NET Core component has no reason to target netstandard2.0, and doing so would force
         Polyfill workarounds through the streaming code for no consumer. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- This is what lets an ASP.NET Core component build under plain Microsoft.NET.Sdk. An
         <Sdk Name="..." /> element cannot substitute for the Microsoft.NET.Sdk.Web outer attribute,
         and this library needs none of what that SDK adds beyond the framework reference: no
         wwwroot, no static web assets, no scoped CSS. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ktsu.Essentials" />
    <PackageReference Include="ktsu.Essentials.EncryptionProviders.Aes" />
    <PackageReference Include="ktsu.Essentials.FileSystemProviders.Native" />
    <PackageReference Include="ktsu.Semantics.Paths" />
    <!-- Used directly, so referenced explicitly rather than relied on transitively (KTSU0006):
         Semantics.Strings supplies the .As<T>() conversion, and the filesystem interface package
         supplies IFileSystem, which the store depends on so a mock filesystem can stand in. -->
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="Testably.Abstractions.FileSystem.Interface" />
  </ItemGroup>
  <PropertyGroup>
    <!-- ktsu.Sdk derives PackageProjectUrl by reading PROJECT_URL.url in its entirety, so the value
         becomes the Windows shortcut file's "[InternetShortcut] URL=..." text rather than a URL. NuGet
         silently drops <projectUrl> from the nuspec as a result, and container publishing fails
         outright because the generated org.opencontainers.image.url label name ends up containing it.
         Set explicitly until the SDK parses the URL out of that file. -->
    <PackageProjectUrl>https://github.com/ktsu-dev/GitLfsCache</PackageProjectUrl>
  </PropertyGroup>
</Project>
